rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function text(value, maximum) { return value is string && value.size() <= maximum; }
    function photo(value) { return text(value, 300000) && (value == '' || value.matches('data:image/(jpeg|png|webp);base64,.*')); }
    // Public social relationships and repost references; only owners may mutate below.
    match /{path=**}/following/{target} { allow read: if true; }
    match /{path=**}/reposts/{uid} { allow read: if true; }
    match /{path=**}/comments/{id} {
      allow read: if signedIn() && resource.data.authorId == request.auth.uid;
    }
    match /balances/{uid} {
      function checkinShape() {
        let p = request.resource.data;
        return p.keys().hasOnly(['current', 'lifetime', 'day', 'updatedAt'])
          && p.current is int && p.lifetime is int && p.day is int
          && p.day == int((request.time.toMillis() + 32400000) / 86400000)
          && p.updatedAt == request.time;
      }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && checkinShape()
        && request.resource.data.current == 10 && request.resource.data.lifetime == 10;
      allow update: if signedIn() && request.auth.uid == uid && checkinShape()
        && request.resource.data.day > resource.data.day
        && request.resource.data.current == resource.data.current + 10
        && request.resource.data.lifetime == resource.data.lifetime + 10;
    }
    match /posts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'author', 'content', 'coin', 'image', 'pinId', 'createdAt', 'support', 'oppose'])
        && request.resource.data.authorId == request.auth.uid
        && text(request.resource.data.author, 24)
        && text(request.resource.data.content, 200) && request.resource.data.content.size() > 0
        && text(request.resource.data.coin, 20) && request.resource.data.coin.matches('[A-Za-z0-9]+')
        && (!('pinId' in request.resource.data) || (text(request.resource.data.pinId, 128) && request.resource.data.pinId.matches('[A-Za-z0-9_-]+') && exists(/databases/$(database)/documents/pins/$(request.resource.data.pinId))))
        && photo(request.resource.data.image) && request.resource.data.createdAt == request.time
        && request.resource.data.support == 0 && request.resource.data.oppose == 0;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /reposts/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/posts/$(id))
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /comments/{commentId} {
        allow read: if exists(/databases/$(database)/documents/posts/$(id));
        allow create: if signedIn() && exists(/databases/$(database)/documents/posts/$(id))
          && request.resource.data.keys().hasOnly(['authorId', 'author', 'content', 'side', 'createdAt'])
          && request.resource.data.side in ['support', 'oppose']
          && request.resource.data.authorId == request.auth.uid && text(request.resource.data.author, 24)
          && text(request.resource.data.content, 1000) && request.resource.data.content.size() > 0
          && request.resource.data.createdAt == request.time;
      }
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'bio', 'profileImage'])
        && text(request.resource.data.username, 24)
        && text(request.resource.data.bio, 200) && photo(request.resource.data.profileImage);
      match /following/{target} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && target != uid
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
    match /pins/{id} {
      function valid() {
        let p = request.resource.data;
        return p.keys().hasOnly(['ownerId', 'slot', 'creator', 'title', 'description', 'coin', 'tradeCoins', 'link', 'image', 'category', 'lat', 'lng'])
          && p.ownerId == request.auth.uid && p.slot in ['0', '1', '2']
          && id == request.auth.uid + '_' + p.slot
          && text(p.creator, 24) && text(p.title, 100) && p.title.size() > 0
          && text(p.description, 200) && p.description.size() > 0
          && text(p.coin, 20) && p.coin.matches('[A-Za-z0-9]+')
          && p.tradeCoins is list && p.tradeCoins.size() <= 110
          && text(p.link, 500) && (p.link == '' || p.link.matches('https?://.*'))
          && photo(p.image) && p.category in ['판매', '구매 희망', '서비스', '사업장']
          && p.lat is number && p.lat >= -90 && p.lat <= 90
          && p.lng is number && p.lng >= -180 && p.lng <= 180;
      }
      allow read: if true;
      allow create: if signedIn() && valid();
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid && valid();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
